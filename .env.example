# Provider seams. Every one of these is optional: with none of them set the
# app does the real local work and labels it honestly rather than pretending
# to have reached the outside world.

# --- email ----------------------------------------------------------------
# local (default) = recorded in email_records only; smtp = really sent.
DOCHUB_DELIVERY=local
DOCHUB_SMTP_URL=smtps://user:pass@smtp.example.com:465
DOCHUB_MAIL_FROM=DocHub <no-reply@example.com>

# --- SAML SSO -------------------------------------------------------------
# Public base URL; the SP entity id and ACS URL are derived from it.
DOCHUB_BASE_URL=https://dochub.example.com
# SP metadata:  $DOCHUB_BASE_URL/api/v1/saml/metadata
# ACS endpoint: $DOCHUB_BASE_URL/api/v1/saml/acs
# Domain ownership is checked with a _dochub TXT record. Set this to "manual"
# to record ownership verified out of band (the API response says it was).
DOCHUB_DOMAIN_VERIFY=

# --- cloud OAuth ----------------------------------------------------------
# A provider is connectable only when both its id and secret are present.
# Redirect URI (register this with each provider):
#   $DOCHUB_BASE_URL/api/v1/integrations/callback
DOCHUB_OAUTH_REDIRECT_URI=
DOCHUB_GOOGLE_CLIENT_ID=
DOCHUB_GOOGLE_CLIENT_SECRET=
DOCHUB_DROPBOX_APP_KEY=
DOCHUB_DROPBOX_APP_SECRET=
DOCHUB_MS_CLIENT_ID=
DOCHUB_MS_CLIENT_SECRET=
DOCHUB_BOX_CLIENT_ID=
DOCHUB_BOX_CLIENT_SECRET=

# --- billing --------------------------------------------------------------
# internal-test (default) applies plan changes locally and labels them;
# stripe creates real Checkout Sessions and waits for the webhook.
DOCHUB_PAYMENT_PROVIDER=internal-test
DOCHUB_STRIPE_SECRET_KEY=
DOCHUB_STRIPE_WEBHOOK_SECRET=
DOCHUB_STRIPE_PRICE_BASIC_MONTHLY=
DOCHUB_STRIPE_PRICE_BASIC_YEARLY=
DOCHUB_STRIPE_PRICE_PRO_MONTHLY=
DOCHUB_STRIPE_PRICE_PRO_YEARLY=
# Point the API at a test double instead of api.stripe.com (used by the e2e).
DOCHUB_STRIPE_API_BASE=

# --- other seams ----------------------------------------------------------
DOCHUB_FAX_PROVIDER_URL=
ANTHROPIC_API_KEY=
